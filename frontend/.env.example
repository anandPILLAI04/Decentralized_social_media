# ╔══════════════════════════════════════════════════════════╗
# ║  Crib Social Media — Frontend Environment Variables     ║
# ║  Copy to .env and fill in real values                   ║
# ╚══════════════════════════════════════════════════════════╝

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:4001/api

# Governance smart contract address on Polygon Amoy
VITE_GOVERNANCE_CONTRACT_ADDRESS=

# Pinata JWT for client-side IPFS uploads (optional — uploads can go through backend)
VITE_PINATA_JWT=

# Web3.Storage token (optional — legacy)
VITE_WEB3_STORAGE_TOKEN=
