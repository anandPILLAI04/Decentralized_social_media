# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/crib_social

# ── Blockchain ────────────────────────────────────────────
PRIVATE_KEY=
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ETHEREUM_RPC_URL=http://127.0.0.1:8545

# ── IPFS / Pinata ────────────────────────────────────────
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# ── AI ────────────────────────────────────────────────────
HUGGING_FACE_API_KEY=

# ── Auth & Admin ──────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-this
ADMIN_KEY=
ADMIN_SECRET_KEY=
